# Conexão com o banco de dados PostgreSQL
# Substitua com sua string de conexão real (ex: Neon, Supabase, Railway, Vercel Postgres ou local)
DATABASE_URL="postgresql://usuario:senha@localhost:5432/active_community_db?schema=public"

# Porta para desenvolvimento local (opcional, padrão 3001)
PORT=3001

# Chave secreta para assinatura dos tokens JWT
JWT_SECRET="seu-jwt-secret-aqui"
